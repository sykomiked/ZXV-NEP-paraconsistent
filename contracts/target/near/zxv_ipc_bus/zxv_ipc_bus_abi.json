  "body": {
    "functions": [
      {
        "name": "attest",
        "doc": " Agent evidence on a task. Re-evaluates the task status:\n   verdict TRUE  -> Ready (executable)\n   verdict BOTH  -> Blocked (quarantined, never executed)\n   verdict FALSE -> Blocked\n   verdict NEITHER -> Queued (waits)",
        "kind": "call",
        "params": {
          "serialization_type": "json",
          "args": [
            {
              "name": "task_id",
              "type_schema": {
                "type": "string"
              }
            },
            {
              "name": "source",
              "type_schema": {
                "description": "NEAR Account Identifier.\n\nThis is a unique, syntactically valid, human-readable account identifier on the NEAR network.\n\n[See the crate-level docs for information about validation.](index.html#account-id-rules)\n\nAlso see [Error kind precedence](AccountId#error-kind-precedence).\n\n## Examples\n\n``` use near_account_id::AccountId;\n\nlet alice: AccountId = \"alice.near\".parse().unwrap();\n\nassert!(\"ƒelicia.near\".parse::<AccountId>().is_err()); // (ƒ is not f) ```",
                "type": "string"
              }
            },
            {
              "name": "value",
              "type_schema": {
                "$ref": "#/definitions/LogicState"
              }
            }
          ]
        },
        "result": {
          "serialization_type": "json",
          "type_schema": {
            "$ref": "#/definitions/TaskStatus"
          }
        }
      },
      {
        "name": "consume",
        "doc": " Mark a task executed. Only READY tasks may be consumed — a\n blocked (disputed) task is refused, and the caller's workflow is\n NOT aborted; the task stays quarantined.",
        "kind": "call",
        "params": {
          "serialization_type": "json",
          "args": [
            {
              "name": "task_id",
              "type_schema": {
                "type": "string"
              }
            }
          ]
        },
        "result": {
          "serialization_type": "json",
          "type_schema": {
            "type": "boolean"
          }
        }
      },
      {
        "name": "contract_source_metadata",
        "kind": "view"
      },
      {
        "name": "new",
        "kind": "call",
        "modifiers": [
          "init"
        ]
      },
      {
        "name": "publish",
        "doc": " Publish a task with the evidence state it needs to run.",
        "kind": "call",
        "params": {
          "serialization_type": "json",
          "args": [
            {
              "name": "task_id",
              "type_schema": {
                "type": "string"
              }
            },
            {
              "name": "payload",
              "type_schema": {
                "type": "string"
              }
            },
            {
              "name": "expected",
              "type_schema": {
                "$ref": "#/definitions/LogicState"
              }
            }
          ]
        }
      },
      {
        "name": "status",
        "doc": " The current task status.",
        "kind": "view",
        "params": {
          "serialization_type": "json",
          "args": [
            {
              "name": "task_id",
              "type_schema": {
                "type": "string"
              }
            }
          ]
        },
        "result": {
          "serialization_type": "json",
          "type_schema": {
            "anyOf": [
              {
                "$ref": "#/definitions/TaskStatus"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      {
        "name": "subscribe",
        "doc": " Subscribe an account to task state-change notifications.",
        "kind": "call",
        "params": {
          "serialization_type": "json",
          "args": [
            {
              "name": "task_id",
              "type_schema": {
                "type": "string"
              }
            },
            {
              "name": "subscriber",
              "type_schema": {
                "description": "NEAR Account Identifier.\n\nThis is a unique, syntactically valid, human-readable account identifier on the NEAR network.\n\n[See the crate-level docs for information about validation.](index.html#account-id-rules)\n\nAlso see [Error kind precedence](AccountId#error-kind-precedence).\n\n## Examples\n\n``` use near_account_id::AccountId;\n\nlet alice: AccountId = \"alice.near\".parse().unwrap();\n\nassert!(\"ƒelicia.near\".parse::<AccountId>().is_err()); // (ƒ is not f) ```",
                "type": "string"
              }
            }
          ]
        }
      }
    ],
    "root_schema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "String",
      "type": "string",
      "definitions": {
        "LogicState": {
          "type": "string",
          "enum": [
            "NEITHER",
            "TRUE",
            "FALSE",
            "BOTH"
          ]
        },
        "TaskStatus": {
          "type": "string",
          "enum": [
            "QUEUED",
            "READY",
            "BLOCKED",
            "DONE"
          ]
        }
      }
    }
  }
